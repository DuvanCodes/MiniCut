<Window x:Class="MiniCut.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniCut" Width="1440" Height="860" Background="#0a1013" Foreground="#e9e9ee" FontFamily="Segoe UI" PreviewKeyDown="OnKey">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#e9e9ee"/><Setter Property="Background" Value="#1c282d"/><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Accent" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#25f4ee"/><Setter Property="Foreground" Value="#031211"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#152024"/><Setter Property="Foreground" Value="#e9e9ee"/><Setter Property="BorderBrush" Value="#2a3b42"/><Setter Property="Padding" Value="6,4"/><Setter Property="CaretBrush" Value="White"/></Style>
    <Style TargetType="Slider">
      <Setter Property="Height" Value="22"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid VerticalAlignment="Center" Height="22" Background="Transparent">
          <Border Height="3" CornerRadius="1.5" Background="#3a464b" VerticalAlignment="Center"/>
          <Track x:Name="PART_Track">
            <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"><Border Height="3" CornerRadius="1.5" Background="#e9e9ee" VerticalAlignment="Center"/></Grid></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
            <Track.Thumb><Thumb Width="12" Height="14"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="White" Width="12" Height="12"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Lbl" TargetType="TextBlock"><Setter Property="Foreground" Value="#8d8d98"/><Setter Property="FontSize" Value="11"/></Style>
  </Window.Resources>
  <Grid>
  <Grid x:Name="Editor" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <Border Height="46" Background="#0f171b" BorderBrush="#1b272c" BorderThickness="0,0,0,1">
      <Grid Margin="12,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="✂ MiniCut" FontSize="16" FontWeight="Bold" Foreground="#25f4ee" Margin="0,0,16,0" VerticalAlignment="Center"/>
          <Button Content="⌂ Inicio" Click="GoHome" Margin="0,0,6,0"/><Button Content="Menú ▾" Click="Menu"/>
          <TextBlock x:Name="SaveLbl" Foreground="#8d98a0" FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="Title" Text="Sin título" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#b8b8c2" Cursor="Hand" ToolTip="Clic para renombrar" MouseLeftButtonUp="RenameProj"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Style="{StaticResource Accent}" Content="Exportar" Click="Export" Margin="0"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="Mid" Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="500" Background="#0f171b" BorderBrush="#1b272c" BorderThickness="0,0,1,0">
        <DockPanel>
          <UniformGrid x:Name="Tabs" Rows="1" DockPanel.Dock="Top" Margin="6,8,6,6"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="116"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Side" Margin="8,6,4,0"/></ScrollViewer>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="4,4,8,4"><WrapPanel x:Name="LeftBody"/></ScrollViewer>
          </Grid>
        </DockPanel>
      </Border>

      <DockPanel Grid.Column="1" Margin="14">
        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0" Height="36">
          <TextBlock x:Name="Clock" Text="00:00:00:00 / 00:00:00:00" VerticalAlignment="Center" Foreground="#25f4ee" FontFamily="Consolas" FontSize="12.5" HorizontalAlignment="Left"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="⏮" Click="ToStart" Background="Transparent"/><Button x:Name="PlayBtn" Style="{StaticResource Accent}" Content="▶" Width="48" Click="Play" ToolTip="Espacio" Margin="0"/>
          </StackPanel>
          <TextBlock x:Name="PlayerInfo" Visibility="Collapsed"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="GridBtn" Content="▦" Click="ToggleGrid" ToolTip="Rejilla" Padding="9,3" Background="Transparent"/>
            <Button x:Name="AspectBtn" Content="16:9 ▾" Click="AspectMenu" ToolTip="Relación de aspecto" Padding="9,3" Background="Transparent"/>
            <Button Content="⛶" Click="ToggleFull" ToolTip="Pantalla completa (F11, Esc para salir)" Padding="9,3" Margin="0" Background="Transparent"/>
          </StackPanel>
        </Grid>
        <Border Background="#0e171b" CornerRadius="8" ClipToBounds="True">
          <Grid>
            <Viewbox Stretch="Uniform"><Canvas x:Name="Stage" Width="1280" Height="720" Background="Black" ClipToBounds="True"/></Viewbox>
            <Viewbox x:Name="GridOv" Stretch="Uniform" IsHitTestVisible="False" Visibility="Collapsed"><Canvas x:Name="GridCv" Width="1280" Height="720"/></Viewbox>
            <Grid x:Name="Monitor" Visibility="Collapsed" Background="Black">
              <MediaElement x:Name="MonitorPlayer" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" Volume="1"/>
              <Image x:Name="MonitorImg" Stretch="Uniform"/>
              <TextBlock x:Name="MonitorLbl" Foreground="#b8b8c2" FontSize="11" Margin="12,10" VerticalAlignment="Top" HorizontalAlignment="Left"/>
              <Button Content="✕" Click="CloseMonitor" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="8,2"/>
            </Grid>
            <TextBlock x:Name="Busy" Foreground="#25f4ee" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
          </Grid>
        </Border>
      </DockPanel>

      <Border Grid.Column="2" Width="370" Background="#0f171b" BorderBrush="#1b272c" BorderThickness="1,0,0,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="DETALLES" Style="{StaticResource Lbl}" Margin="14,12,0,6"/>
          <WrapPanel x:Name="DetailTabs" DockPanel.Dock="Top" Margin="10,0,10,8"/>
          <Border x:Name="DetailSub" DockPanel.Dock="Top" Margin="14,0,14,6" Background="#121c20" CornerRadius="6" Padding="2" Visibility="Collapsed"><UniformGrid x:Name="SubGrid" Rows="1"/></Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Details" Margin="14,0,14,14"/></ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Height="40" Background="#0f171b" BorderBrush="#1b272c" BorderThickness="0,1,0,0">
      <Grid Margin="12,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="↶" Click="Undo" ToolTip="Deshacer (Ctrl+Z)"/><Button Content="↷" Click="Redo" ToolTip="Rehacer (Ctrl+Y)"/>
          <Border Width="1" Height="18" Background="#2a3b42" Margin="2,0,8,6"/>
          <Button Content="✂" Click="Split" ToolTip="Dividir (S)"/><Button Content="🗑" Click="Delete" ToolTip="Eliminar (Supr)"/>
          <Button Content="❄" Click="Freeze" ToolTip="Congelar fotograma"/><Button Content="⟳" Click="Rotate90" ToolTip="Rotar 90°"/><Button Content="⇋" Click="Mirror" ToolTip="Espejo"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="SnapBtn" Content="🧲" Click="ToggleSnap" ToolTip="Imán: ajustar a los bordes de los clips" Background="#0f4448" Foreground="#25f4ee" Padding="9,4"/><Button Content="⤢" Click="FitZoom" ToolTip="Ajustar la línea de tiempo a la ventana" Padding="9,4" Margin="0,0,14,0"/><TextBlock Text="⊖" Foreground="#8d98a0" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <Slider x:Name="Zoom" Width="130" Minimum="10" Maximum="150" Value="50" ValueChanged="ZoomChanged"/><TextBlock Text="⊕" Foreground="#8d98a0" VerticalAlignment="Center" Margin="6,0,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="3" Height="312" Background="#0b1215">
      <Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel x:Name="TrackLabels" Margin="0,26,0,0"/>
      <ScrollViewer Grid.Column="1" x:Name="TlScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <Canvas x:Name="TL" MouseLeftButtonDown="TlDown" Background="Transparent"/>
      </ScrollViewer>
    </Grid>
  </Grid>

  <Grid x:Name="HomeView" Background="#0a1013">
    <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#0d1519" BorderBrush="#1b272c" BorderThickness="0,0,1,0" Padding="14,16">
      <DockPanel LastChildFill="False">
        <TextBlock DockPanel.Dock="Top" Text="✂ MiniCut" FontSize="17" FontWeight="Bold" Foreground="#25f4ee" Margin="4,0,0,18"/>
        <Border DockPanel.Dock="Top" Background="#121c20" CornerRadius="10" Padding="10" Margin="0,0,0,18">
          <StackPanel Orientation="Horizontal">
            <Border Width="38" Height="38" CornerRadius="19" Background="#25f4ee"><TextBlock Text="D" FontWeight="Bold" Foreground="#031211" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="Mi espacio" FontSize="13" Foreground="#f1f5f6"/><TextBlock Text="Proyectos locales" Style="{StaticResource Lbl}"/></StackPanel>
          </StackPanel>
        </Border>
        <Button x:Name="NavHome" DockPanel.Dock="Top" Content="⌂   Inicio" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,4"/>
        <Button x:Name="NavTpl" DockPanel.Dock="Top" Content="▭   Plantillas" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Bottom" Text="Los proyectos se guardan solos." Style="{StaticResource Lbl}" Margin="6,0,0,2" TextWrapping="Wrap"/>
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="HomeBody" Margin="28,22,28,24"/></ScrollViewer>
  </Grid>
  </Grid>
</Window>









